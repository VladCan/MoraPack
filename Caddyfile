# Activa la compresión para acelerar la carga
encode zstd gzip

# --- 1. Enrutamiento de la API ---
#
# Todas las peticiones que empiecen con /api/...
# se redirigen al servicio 'backend' en el puerto 8080.
#
# IMPORTANTE: handle_path elimina el prefijo /api.
# Ejemplo: Petición a /api/usuarios
# Se redirige a -> backend:8080/usuarios
#
handle_path /api/* {
    reverse_proxy backend:8080
}

# --- 2. Enrutamiento del Frontend ---
#
# Todas las demás peticiones (/*) se consideran
# parte del frontend.
#
handle {
    # Se redirigen al servicio 'frontend' en el puerto 80
    # (que es el Caddy interno del frontend)
    reverse_proxy frontend:80
}

# --- Configuración de Email para HTTPS (Let's Encrypt) ---
